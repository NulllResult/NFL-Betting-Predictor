<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#0A0F14">

    <!-- SCORE BANNER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#141922"
        android:padding="8dp">
        <ViewFlipper
            android:id="@+id/scoreBannerFlipper"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:autoStart="true"
            android:flipInterval="5000"
            android:inAnimation="@anim/slide_in_right"
            android:outAnimation="@anim/slide_out_left" />
    </LinearLayout>

    <!-- MAIN CONTENT AREA (Text or Cards) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#141922"
                android:padding="8dp">

                <TextView
                    android:id="@+id/resultText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#F0F4FF"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp" />
            </ScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <ScrollView
            android:id="@+id/gamesScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#060810"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/gamesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <ProgressBar
            android:id="@+id/loadingIndicator"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/testButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="TEST"
            android:textSize="11sp"
            android:backgroundTint="#1C222C" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/loadStatsButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="STATS"
            android:textSize="11sp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#1C222C" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/predictButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="PREDICT"
            android:textSize="11sp"
            android:backgroundTint="#1C222C" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/refreshAllButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="REFRESH"
            android:textSize="11sp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#1C222C" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="CLEAR"
            android:textSize="11sp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#1C222C" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/helpButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="PLAYER →"
        android:textSize="14sp"
        android:backgroundTint="#FFB612" />

</LinearLayout>
